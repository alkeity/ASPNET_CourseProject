@using Microsoft.AspNetCore.Http
@using PhantasmalARTdemo
@using PhantasmalARTdemo.Helpers.Html
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@model PhantasmalARTdemo.Models.Containers.ArtDisplayView

@{
    string? username = HttpContextAccessor.HttpContext.Session.GetString("UserName");
}

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-8">
            <figure class="mb-4">
                <img class="img-fluid rounded" src="@Model.Art.FilePath" alt="@Model.Art.Title" />
            </figure>

            @* Comments will be here *@
            <section class="mb-5">
                <div class="card bg-light">
                    <div class="card-header">Comments:</div>
                    <div class="card-body">
                        @if (username != null)
                        {
                            @using (Html.BeginForm("AddArtComment", "Comment", routeValues: new { artist = Model.Art.Author, externalUUID = Model.Art.ExternalUUID }, FormMethod.Post, antiforgery: null, htmlAttributes: new { enctype = "multipart/form-data" }))
                            {
                                <div class="mb-4">
                                    @Html.TextAreaFor(Model => Model.CommentForm.Entity.Text, htmlAttributes: new { @class = "form-control mb-4", id = "commenttext", placeholder = "Anything nice to say?", rows = 3 })
                                </div>
                                <button type="submit" class="btn btn-primary w-100 mb-4">Submit</button>
                            }
                        }

                        @* Comments *@
                        @if (Model.Comments.Items.Count > 0)
                        {
                            @foreach (var comment in Model.Comments.Items)
                            {
                                <div class="d-flex">
                                    <div class="ms-3">
                                        <div class="fw-bold">@comment.Author</div>
                                        <div class="text-muted fst-italic mb-2">@comment.CreatedAt.ToLocalTime().ToShortDateString() @comment.CreatedAt.ToLocalTime().ToShortTimeString()</div>
                                        <p>@comment.Text</p>
                                    </div>
                                </div>
                            }

                            @if (Model.Comments.MaxPage > 0)
                            {
                                @Html.PaginationSimple(Model.Comments.CurPage, Model.Comments.CurPage)
                            }
                        }
                    </div>
                </div>
            </section>
        </div>

        @* Side widget *@
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header">About</div>
                <div class="card-body">
                    <h2 class="fw-bolder mb-1">@Model.Art.Title</h2>
                    <div class="text-muted fst-italic mb-2">
                        Posted on @Model.Art.CreatedAt.ToLocalTime().ToShortDateString() by
                        <a class="nav-link text-dark" asp-controller="User" asp-action="Profile" asp-route-username="@Model.Art.Author">@Model.Art.Author</a>
                    </div>
                    <p class="fs-5 mb-4">@Model.Art.Description</p>
                    @if (username == Model.Art.Author)
                    {
                        <a class="btn btn-primary w-100 mb-4" 
                        asp-controller="Art" asp-action="UpdateGet"
                           asp-route-username="@Model.Art.Author" asp-route-externalUUID="@Model.Art.ExternalUUID">
                            Edit
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
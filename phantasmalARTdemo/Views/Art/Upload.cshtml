@using Microsoft.AspNetCore.Http
@using PhantasmalARTdemo
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model PhantasmalARTdemo.Models.View.ArtUploadModel

<h1 class="text-center">Upload</h1>

@if (Model.Errors != null)
{
    <div class="alert alert-danger">
        <strong>A problem has occurred while submitting your data.</strong>
        <ul>
            @for (int i = 0; i < Model.Errors.Count; i++)
            {
                <li>@Model.Errors[i]</li>
            }
        </ul>

    </div>
}

<div class="container form-container" style="max-width: 75vh">
    @using (Html.BeginForm("Upload", "Art", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <div class="form-outline flex-fill mb-3">
            @Html.TextBoxFor(Model => Model.Image, htmlAttributes: new { @type = "file", @class = "form-control form-control-lg", id = "image-upload", required = "required", accept = "image/jpeg,image/png" })
        </div>
        <div class="form-floating form-outline flex-fill mb-3">
            @Html.TextBoxFor(Model => Model.ArtDTO.Title, htmlAttributes: new { @class = "form-control", id = "title", placeholder = "Title", required = "required" })
            @Html.LabelFor(Model => Model.ArtDTO.Title, htmlAttributes: new { @class = "form-label", @for = "title" })
        </div>
        <div class="form-floating form-outline flex-fill mb-3">
            @Html.TextAreaFor(Model => Model.ArtDTO.Description, htmlAttributes: new { @class = "form-control", id = "descr", placeholder = "Description", rows = 3 })
            @Html.LabelFor(Model => Model.ArtDTO.Description, htmlAttributes: new { @class = "form-label", @for = "title" })
        </div>

        <div class="form-floating form-outline d-flex mb-3">
            <button type="submit" class="btn btn-primary mb-4 me-1 w-50">Submit</button>
            <a class="btn btn-outline-secondary mb-4 flex-grow-1" href="javascript:history.back()" aria-label="Go back to previous page">Go Back</a>
        </div>
    }
</div>
